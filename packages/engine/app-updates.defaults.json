{
  "dirName": "app-updates",
  "keep": 3,
  "maxFutureStampMs": 300000,
  "blobFileName": "bundle.bin.gz",
  "entriesFileName": "entries.json",
  "manifestFileName": "manifest.json",
  "currentFileName": "current.json",
  "incomingPrefix": ".incoming-",
  "maxManifestBytes": 65536,
  "maxEntriesChars": 786432,
  "maxEntries": 20000,
  "maxLinks": 256,
  "maxFileBytes": 1073741824,
  "maxTotalBytes": 2147483648,
  "tokenTtlMs": 600000,
  "tokenBytes": 32,
  "maxTokens": 32,
  "maxTokensPerConnection": 4,
  "maxStreams": 4,
  "retryAfterS": 2,
  "chunkBytes": 262144,
  "maxClients": 64,
  "plutilPath": "/usr/bin/plutil",
  "buildIdPlistKey": "KokpitBuildId",
  "versionPlistKey": "CFBundleShortVersionString",
  "sourceDir": "../app/dist/mac-arm64",
  "sourcePattern": "^.+\\.app$",
  "signingKeyDir": "~/.config/kokpit/app-signing",
  "updateKeyIdPlistKey": "KokpitUpdateKeyId"
}
